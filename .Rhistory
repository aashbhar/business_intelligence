# 2. Function to scrape a single department directory page
scrape_dept_directory = function(dept_name, dept_url) {
Sys.sleep(1)
page_html = httr2::request(dept_url) |>
httr2::req_user_agent("ISA 401 class scraper (bhargaa2@miamioh.edu)") |>
httr2::req_perform() |>
httr2::resp_body_html()
# Select all table rows inside the main directory table
cards = page_html |>
rvest::html_elements("#sidebar-main table tbody tr")
dept_data = purrr::map_dfr(cards, function(card) {
# Extract Name (located in the first column / link)
name = card |>
rvest::html_element("td:nth-child(1) a, a, .name") |>
rvest::html_text2()
# Extract Position (located in the 3rd column / <i> tag)
position = card |>
rvest::html_element("td:nth-child(3) i, td:nth-child(3)") |>
rvest::html_text2()
# Extract Website URL
website = card |>
rvest::html_element("a") |>
rvest::html_attr("href")
# Convert relative URLs to absolute links
if (!is.na(website) && !stringr::str_starts(website, "http")) {
website = stringr::str_c("https://miamioh.edu", website)
}
tibble::tibble(
department = dept_name,
name = name,
position = position,
website = website
)
}) |>
dplyr::filter(!is.na(name) & name != "") # Remove empty header/spacer rows
return(dept_data)
}
# department URLs and combine results
fsb_directory = purrr::map2_dfr(
departments$department,
departments$url,
scrape_dept_directory
)
