all_classes <- c()
start_val <- 1
repeat {
url <- paste0("https://isa401-salvage.vercel.app/exam/registry?start=", start_val)
page_html <- httr2::request(url) |>
httr2::req_user_agent("ISA 401 class scraper (bhargaa2@miamioh.edu)") |>
httr2::req_perform() |>
httr2::resp_body_html()
page_classes <- page_html |>
rvest::html_elements("#w2 > div > h3") |>
rvest::html_text2()
if (length(page_classes) == 0) break   # no more wrecks -> stop
all_classes <- c(all_classes, page_classes)
start_val <- start_val + 1   # adjust the increment to match how the site paginates
}
