library(jsonlite)
# Read the campus JSON file
campus_data <- fromJSON("https://isa401-find-your-seat.vercel.app/campus.json")
# Farmer School of Business is its own top-level element, not a row in a "buildings" table
fsb_data <- campus_data$Farmer
# Floors is a named list keyed by floor number ("0", "1", "2", "3")
floor1 <- fsb_data$floors[["1"]]
# Each floor already carries a precomputed section count
total_sections <- floor1$sections
print(total_sections)
