# 2. Function to scrape a single department directory page
scrape_dept_directory = function(dept_name, dept_url) {
# Polite delay between requests (Class 11 practice)
Sys.sleep(1)
# Fetch HTML using httr2 with your Miami email in the User-Agent header
page_html = httr2::request(dept_url) |>
httr2::req_user_agent("ISA 401 class scraper (bhargaa2@miamioh.edu)") |>
httr2::req_perform() |>
httr2::resp_body_html()
# Select individual member container elements
# Card-level extraction ensures names, positions, and websites stay aligned on the same row
cards = page_html |>
rvest::html_elements("tr, .directory-item, .person-card, .profile-card, .media")
# Extract details from each container block
dept_data = purrr::map_dfr(cards, function(card) {
name = card |>
rvest::html_element("a, .name, h3, .profile-name") |>
rvest::html_text2()
position = card |>
rvest::html_element(".title, .position, .job-title, td:nth-child(2)") |>
rvest::html_text2()
website = card |>
rvest::html_element("a") |>
rvest::html_attr("href")
# Ensure relative links are converted to absolute URLs
if (!is.na(website) && !stringr::str_starts(website, "http")) {
website = stringr::str_c("https://miamioh.edu", website)
}
tibble::tibble(
department = dept_name,
name = name,
position = position,
website = website
)
}) |>
dplyr::filter(!is.na(name) & name != "") # Filter out empty header rows if present
return(dept_data)
}
# 3. Iterate over all 7 department URLs and combine results
fsb_directory = purrr::map2_dfr(
departments\$department,
