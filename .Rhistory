"ISA 401 class scraper (bhargaa2@miamioh.edu)"
) |>
httr2::req_perform() |>
httr2::resp_body_html()
rows = page_html |>
rvest::html_elements("table tbody tr")
dept_data = purrr::map_dfr(rows, function(row) {
person_cell = row |>
rvest::html_element("td:nth-child(3)")
name = person_cell |>
rvest::html_element("a") |>
rvest::html_text2()
if (is.na(name) || name == "") {
return(NULL)
}
website = person_cell |>
rvest::html_element("a") |>
rvest::html_attr("href")
position = person_cell |>
rvest::html_text2() |>
stringr::str_remove(
paste0("^", stringr::fixed(name))
) |>
stringr::str_squish()
if (!is.na(website) &&
!stringr::str_starts(website, "http")) {
website = paste0("https://miamioh.edu", website)
}
tibble::tibble(
department = dept_name,
name = name,
position = position,
website = website
)
})
return(dept_data)
}
